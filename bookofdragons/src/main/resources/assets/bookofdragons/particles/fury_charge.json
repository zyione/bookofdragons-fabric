{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "fury_charge",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "bookofdragons/textures/particle/furytrail"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 120,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0, -0.2],
				"radius": 0.1,
				"direction": ["math.random(-0.5,0.5 )", 0, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 6,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.sin(v.particle_age * 90)", 10, "math.cos(v.particle_age * 40)"],
				"linear_drag_coefficient": 5,
				"rotation_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 16,
						"max_frame": 16,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.2
			}
		}
	}
}