          "to": "run_takeoff",
          "when": {"is_sitting": false, "is_incapacitated": false, "is_charging_takeoff": true, "horiz_speed": "$run_from"}
        },
        {
          "to": "walk_takeoff",
          "when": {"is_sitting": false, "is_incapacitated": false, "is_charging_takeoff": true, "horiz_speed": 0.015}
        },
        {
          "to": "beg_prowl",
